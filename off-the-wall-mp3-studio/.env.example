HOST=127.0.0.1
PORT=8093
DATA_DIR=./data
MAX_PLAYLIST_ITEMS=100
MAX_CONCURRENT_JOBS=2
# Necesario al exponer el servidor fuera de localhost.
APP_PASSWORD=
# Opcionales: API de Spotify. Sin estas claves se consultan metadatos públicos del embed.
# En Render se configuran en Environment. Nunca se envían al navegador.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Opcional: usar un FFmpeg instalado en lugar del incluido.
FFMPEG_PATH=

# Opcional: archivo Netscape de cookies de YouTube en el servidor (nunca en GitHub).
# En Render puede apuntar a un Secret File: /etc/secrets/youtube-cookies.txt
YTDLP_COOKIES_FILE=

# Download Manager: YouTube mediante la tarea del actor Apify seleccionado.
# Configurar como secreto de Render. Nunca poner valores reales en GitHub.
APIFY_TOKEN=
APIFY_TASK_ID=
# Hosts exactos de almacenamiento HTTPS de salida (separados por comas).
APIFY_DOWNLOAD_HOSTS=
# Campo del item del dataset que contiene un enlace directo al audio; admite puntos.
APIFY_OUTPUT_URL_FIELD=downloadUrl
