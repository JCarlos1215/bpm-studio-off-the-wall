HOST=127.0.0.1
PORT=8093
DATA_DIR=./data
MAX_PLAYLIST_ITEMS=100
MAX_CONCURRENT_JOBS=2
# Necesario al exponer el servidor fuera de localhost.
APP_PASSWORD=
# Opcionales: datos de Spotify. Nunca se envían al navegador.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Opcional: usar un FFmpeg instalado en lugar del incluido.
FFMPEG_PATH=
